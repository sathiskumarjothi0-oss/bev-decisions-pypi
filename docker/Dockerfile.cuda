# Bev HTTP server on an NVIDIA GPU (needed for Bev-Pro-C: about 60 GB of GPU memory).
#   docker build -f docker/Dockerfile.cuda -t bev-cuda .
#   docker run --gpus all -p 8000:8000 -v hf-cache:/root/.cache/huggingface bev-cuda
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu128   # CUDA libraries come with the wheel; the host needs the NVIDIA driver and container toolkit
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir ".[pro,serve]"
ENV BEV_MODEL=sathiskumarjothi0/Bev-Pro-C
EXPOSE 8000
CMD ["sh", "-c", "bev serve --host 0.0.0.0 --port 8000 --model $BEV_MODEL"]
